            <q1:defaultValue value="0" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_201104" access="readWrite">
            <description lang="en">For Micropower internal use only. Set to 0.</description>
            <USINT />
            <q1:defaultValue value="0" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_201105" access="readWrite">
            <description lang="en">For Micropower internal use only. Set to 0.</description>
            <USINT />
            <q1:defaultValue value="0" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_201106" access="readWrite">
            <description lang="en">BMS charging state
1 : Main charging state
2 : Balancing state
3 : Ready state
4 - 255 : Reserved</description>
            <USINT />
            <q1:defaultValue value="0" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_201107" access="readWrite">
            <description lang="en">State of charge, 0-100%</description>
            <USINT />
            <q1:defaultValue value="0" />
            <q1:allowedValues>
              <q1:range>
                <minValue value="0" />
                <maxValue value="100" />
              </q1:range>
            </q1:allowedValues>
          </q1:parameter>
          <q1:parameter uniqueID="UID_OBJ_2012">
            <label lang="en">Measurments</label>
            <q1:dataTypeIDRef uniqueIDRef="UID_REC_2012" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_201200">
            <label lang="en">Highest sub-index supported</label>
            <USINT />
            <q1:defaultValue value="0x07" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_201201" access="noAccess">
            <description lang="en">IEEE-754 Float. Average measured voltage (V) since the last SYNC.</description>
            <UDINT />
            <q1:defaultValue value="0" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_201202" access="noAccess">
            <description lang="en">IEEE-754 Float. Average measured current (A) since the last SYNC.</description>
            <UDINT />
            <q1:defaultValue value="0" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_201203" access="noAccess">
            <description lang="en">IEEE-754 Float. Average measured power (W) since the last SYNC.</description>
            <UDINT />
            <q1:defaultValue value="0" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_201204" access="noAccess">
            <description lang="en">Information status field.
b0 : The output voltage is near set value. Close enough to considered as limiter
b1 : The output current is near set value. Close enough to considered as limiter
b2 : The output power is near set value. Close enough to considered as limiter
b3-6 :Output limiter (with priority)
	0: None
	1: Uset, voltage set value (8)
	2: Iset, current set value (6)
	3: Pset, power set value (10)
	4: Charger internal temperature (11)
	5: Power unit voltage boundary (7)
	6: Power unit current boundary (1)
	7: Power unit power boundary (9)
	8: Idc limit, output current limit (3)
	9: Iac limit, input current limit (2)
	10: Pac limit, input power limit (4)
	11: Phase error, one or two phases missing (5)
b7 : reserved </description>
            <USINT />
            <q1:defaultValue value="0" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_201205" access="noAccess">
            <description lang="en">Derate status field. Different from zero if and only if charged output is limited by something else than the input set values.
Bit 0 Charger output derated due to phase error.
Bit 1 Charger output derated due to user defined parameters. I.e., AC current, AC power, DC current
Bit 2 Charger output derated by power unit boundaries
Bit 3 Charger output derated due charger internal temperature
Bit 4 Charger output derated due to no load detected
Bit 5 Charger output derated due to low battery voltage.
Bit 6 Charger output derated due to high battery voltage.
Bit 7 Reserve</description>
            <USINT />
            <q1:defaultValue value="0" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_201206" access="noAccess">
            <description lang="en">Warning status field. Different from zero if and only if a faulty component is detected. Charger can still output power but could be derated
Bit 0 Phase error
Bit 1 Regulator error
Bit 2 Low charger temperature
Bit 3 High charger temperature
Bit 4 All batteries not connected
Bit 5 Voltage difference &gt; 6 V between chargers in cluster
Bit 6 Hardware temperature protection active
Bit 7 CAN timeout on one or more cluster members</description>
            <USINT />
            <q1:defaultValue value="0" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_201207" access="noAccess">
            <description lang="en">Error status field. Different from zero if and only if charger cannot deliver any output.
Bit 0 Phase error
Bit 1 Regulator error
Bit 2 Low charger temperature
Bit 3 High charger temperature
Bit 4 Reserved
Bit 5 Reserved
Bit 6 Hardware temperature protection active
Bit 7 CAN timeout</description>
            <USINT />
            <q1:defaultValue value="0" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_OBJ_2014">
            <label lang="en">Start/stop</label>
            <q1:dataTypeIDRef uniqueIDRef="UID_REC_2014" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_201400">
            <label lang="en">Highest sub-index supported</label>
            <USINT />
            <q1:defaultValue value="0x02" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_201401" access="readWrite">
            <description lang="en">0 Stop
1 Start</description>
            <USINT />
            <q1:defaultValue value="0" />
            <q1:allowedValues>
              <q1:range>
                <minValue value="0" />
                <maxValue value="1" />
              </q1:range>
            </q1:allowedValues>
          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_201402" access="readWrite">
            <description lang="en">0 The Start/stop parameter OR Remote 
input starts the charging process.

1 Both the Start/stop parameter AND the 
Remote input must be active to start 
the charging process.</description>
            <USINT />
            <q1:defaultValue value="0" />
            <q1:allowedValues>
              <q1:range>
                <minValue value="0" />
                <maxValue value="1" />
              </q1:range>
            </q1:allowedValues>
          </q1:parameter>
          <q1:parameter uniqueID="UID_OBJ_2015">
            <label lang="en">Charger status</label>
            <q1:dataTypeIDRef uniqueIDRef="UID_REC_2015" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_201500">
            <label lang="en">Highest sub-index supported</label>
            <USINT />
            <q1:defaultValue value="0x06" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_201501">
            <description lang="en">Charger identification. E.g., lowest 4 digits of the BCU serial 
number.</description>
            <UINT />
            <q1:defaultValue value="0" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_201502">
            <description lang="en">Charging related status
Bit 0 Mains connected
Bit 1 Battery connected
Bit 2 BMU connected
Bit 3 Main charging
Bit 4 Additional charging
Bit 5 Equalize charging
Bit 6 Maintenance charging
Bit 7 Charging completed
Bit 8 Pause
Bit 9 Pre charging
Bit 10 Force start 
Bit 11 Best Battery Choice (BBC)
Bit 12 Low battery temp
Bit 13 High battery temp
Bit 14 Charging restricted 
Bit 15 Internal program flag</description>
            <UINT />
            <q1:defaultValue value="0" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_201503">
            <description lang="en">Power limitation reasons (with priority).
0 None
1 Uset, Voltage set value (8)
2 Iset, Current set value (6)
3 Pset, Power set value (10)
4 Charger temp, Charger internal temperature (11)
5 UmaxEngine, Power unit voltage boundary (7)
6 ImaxEngine, Power unit current boundary (1)
7 PmaxEngine, Power unit power boundary (9)
8 IdcLimit, Output current limit (3)
9 IacLimit, Input current limit (2)
10 PacLimit, Input power limit (4)
11 Phase, one or two phases missing (5)
12 – 255 Reserved</description>
            <USINT />
            <q1:defaultValue value="0" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_201504">
            <description lang="en">Charged Ah in percent of capacity</description>
            <USINT />
            <q1:defaultValue value="0" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_201505">
            <description lang="en">Charger algorithm error codes. Only one error can be displayed 
even though there can be more than one error. Priority order 
within parentheses.
0 None
1 Low battery voltage (1)
2 High battery voltage (2)
3 Charge time limit (3)
4 Charge Ah limit (4)
5 Incorrect charge algorithm (5)
6 Tilt sensor error (11) 
7 High battery voltage, power unit shut off (6)
8 Battery error (delta U/I/P) (7) 
9 Low air pump pressure (8) 
10 High air pump pressure (9) 
11 – 255 Reserved</description>
            <USINT />
            <q1:defaultValue value="0" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_201506">
            <description lang="en">Regulator error codes. Only one error can be displayed even 
though there can be more than one error. Priority order within 
parentheses.
0 None
17 Phase error (1)
18 Regulator error (2)
19 Low heat sink temp (3)
20 High heat sink temp (4)
21 Low board temp (5)
22 High board temp (6)
23 High trafo temp (7)
24 CAN timeout (8)</description>
            <USINT />
            <q1:defaultValue value="0" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_OBJ_2016">
            <label lang="en">Battery Status</label>
            <q1:dataTypeIDRef uniqueIDRef="UID_REC_2016" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_201600">
            <label lang="en">Highest sub-index supported</label>
            <USINT />
            <q1:defaultValue value="0x05" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_201601">
            <description lang="en">Battery identification. E.g., lowest 4 digits of the battery serial number.</description>
            <UINT />
            <q1:defaultValue value="0" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_201602">
            <description lang="en">Battery module status
Bit 0 Discharging
Bit 1 Charging
Bit 2 Radio status connected
Bit 3 Radio status joining
Bit 4 Radio status starting
Bit 5 Radio status joining enabled
Bit 6 Equalize function enabled
Bit 7 Need equalize
Bit 8 Water function enabled
Bit 9 Need water
Bit 10 Connected to charger
Bit 11 Need calibration
Bit 12 Shunt temp sensor connected
Bit 13 Reserved
Bit 14 Reserved
Bit 15 Reserved</description>
            <UINT />
            <q1:defaultValue value="0" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_201603">
            <description lang="en">Battery temperature. Unit 0.1°C. Range 0 – 6553.5°C</description>
            <UINT />
            <q1:defaultValue value="0" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_201604">
            <description lang="en">State of Charge. 0 – 100%.</description>
            <USINT />
            <q1:defaultValue value="0" />
            <q1:allowedValues>
              <q1:range>
                <minValue value="0" />
                <maxValue value="100" />
              </q1:range>
            </q1:allowedValues>
          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_201605">
            <description lang="en">Battery module error codes. Only one error can be displayed even though there can be more 
than one error.
0 None
101 BMU high battery temperature
102 BMU low electrolyte level
103 BMU battery voltage not in balance</description>
            <USINT />
            <q1:defaultValue value="0" />
            <q1:allowedValues>
              <q1:range>
                <minValue value="0" />
                <maxValue value="100" />
              </q1:range>
            </q1:allowedValues>
          </q1:parameter>
          <q1:parameter uniqueID="UID_OBJ_2020">
            <label lang="en">Charger Capacity</label>
            <q1:dataTypeIDRef uniqueIDRef="UID_REC_2020" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_202000">
            <label lang="en">Highest sub-index supported</label>
            <USINT />
            <q1:defaultValue value="0x01" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_202001">
            <description lang="en">Maximum DC voltage (mV) the charger can be exposed for on the secondary side without 
damage. Primarily used in scenarios where the connector between battery and charger does 
not have voltage coding</description>
            <UDINT />
            <q1:defaultValue value="0" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_OBJ_2030">
            <label lang="en">Remaining Charge Time</label>
            <q1:dataTypeIDRef uniqueIDRef="UID_REC_2030" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_203000">
            <label lang="en">Highest sub-index supported</label>
            <USINT />
            <q1:defaultValue value="0x01" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_203001" access="readWrite">
            <description lang="en">The number of minutes remaining until the battery is fully charged.</description>
            <UDINT />
            <q1:defaultValue value="0" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_OBJ_2040">
            <label lang="en">Charging Parameters</label>
            <q1:dataTypeIDRef uniqueIDRef="UID_REC_2040" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_204000">
            <label lang="en">Highest sub-index supported</label>
            <USINT />
            <q1:defaultValue value="0x07" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_204001" access="readWrite">
            <description lang="en">1-0x7F - Default : 0x2C
Node ID to be used for CAN communication. Writing Node IDs 1-127 to 
signifies that fixed values are to be used while writing Node ID to 0 signifies 
that Automatic mode for Node ID is to be used</description>
            <USINT />
            <q1:defaultValue value="0x2C" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_204002" access="readWrite">
            <description lang="en">1-0x7F - Default : 0x2C</description>
            <UINT />
            <q1:allowedValues>
              <q1:range>
                <minValue value="20" />
                <maxValue value="1000" />
              </q1:range>
            </q1:allowedValues>
          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_204003" access="readWrite">
            <description lang="en">The charge curve index as described in [4]. A 0 here means charging via BMS 
control instead of charge curve</description>
            <UINT />
            <q1:defaultValue value="0" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_204004" access="readWrite">
            <label lang="en">Number of Cells in series </label>
            <UINT />
            <q1:defaultValue value="0" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_204005" access="readWrite">
            <label lang="en">Battery Capacity (Ah) </label>
            <UINT />
            <q1:defaultValue value="0" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_204006" access="readWrite">
            <label lang="en">Base load (mA) </label>
            <UINT />
            <q1:defaultValue value="0" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_204007" access="readWrite">
            <label lang="en">Cable resistance compensation (mΩ)</label>
            <UINT />
            <q1:defaultValue value="0" />
            <q1:allowedValues>
              <q1:range>
                <minValue value="0" />
                <maxValue value="1000" />
              </q1:range>
            </q1:allowedValues>
          </q1:parameter>
          <q1:parameter uniqueID="UID_OBJ_2041">
            <label lang="en">Charging Curve Parameters</label>
            <q1:dataTypeIDRef uniqueIDRef="UID_REC_2041" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_204100">
            <label lang="en">Highest sub-index supported</label>
            <USINT />
            <q1:defaultValue value="0x01" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_SUB_204101" access="readWrite">
            <label lang="en">Charge curve specific 1-nmax</label>
            <UDINT />
            <q1:defaultValue value="0" />
          </q1:parameter>
        </q1:parameterList>
      </q1:ApplicationProcess>
    </ProfileBody>
  </ISO15745Profile>
